# EchoLore environment variables
# Copy this file to .env and fill in the values you need.

# --- Local preview (Prisma + SQLite) ---
# Used when NEXT_PUBLIC_SUPABASE_URL is NOT set.
# This is the default for local development — no external services required.
DATABASE_URL=file:./db/custom.db

# --- Production (Supabase + pgvector) ---
# Required for Vercel deployment. Create a project at https://supabase.com/dashboard,
# run supabase/schema.sql in the SQL editor, then copy these values from
# Project Settings → API.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
