# EchoLore environment variables
# Copy this file to .env and fill in the values.
#
# 1. Create a free Supabase project: https://supabase.com/dashboard
# 2. Run supabase/schema.sql in the Supabase SQL editor (Database → SQL Editor → New query)
# 3. Project Settings → API → copy these values

# Supabase project URL (e.g. https://yourproject.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — safe to expose in the browser (RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER ONLY. Bypasses RLS.
# Used by route handlers until Supabase Auth is wired up.
# NEVER commit this. NEVER prefix with NEXT_PUBLIC_.
# Find it at: Project Settings → API → "service_role secret"
SUPABASE_SERVICE_ROLE_KEY=
